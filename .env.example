# Twilio Console → Account Info
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=replace_with_auth_token

# Public HTTPS base URL from ngrok; no trailing slash.
PUBLIC_BASE_URL=https://your-subdomain.ngrok-free.app

# Your own phone number in E.164 format, e.g. +91XXXXXXXXXX
ALLOWED_PHONE=+91XXXXXXXXXX

# Generate a unique 6-8 digit PIN. Do not reuse a banking or device PIN.
ACCESS_PIN=replace_with_random_pin

# Optional: voice and session controls
VOICE_LANGUAGE=en-US
SESSION_TTL_SECONDS=300
MAX_PIN_ATTEMPTS=5
