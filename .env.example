# Optional local configuration. No API keys or cloud accounts are required.
# Defaults store data in ~/.p2c/p2c.sqlite3.
# P2C_DATA_DIR=/Users/you/.p2c
# P2C_DB_PATH=/Users/you/.p2c/p2c.sqlite3
# P2C_SESSION_TTL_SECONDS=28800
# P2C_PAIRING_TTL_SECONDS=180
# Set to 1 only when serving over HTTPS.
# P2C_COOKIE_SECURE=0
